FROM golang:1.27.1-alpine AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -o /out/gimbal-worker ./cmd/gimbal-worker

FROM alpine:3.22
RUN apk add --no-cache bash git
COPY --from=build /out/gimbal-worker /usr/local/bin/gimbal-worker
ENTRYPOINT ["/usr/local/bin/gimbal-worker"]
CMD ["worker"]
