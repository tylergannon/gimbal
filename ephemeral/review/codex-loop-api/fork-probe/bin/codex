#!/usr/bin/env python3
import sys,json,os
from pathlib import Path
base=Path(__file__).resolve().parent.parent
with (base/'pids.txt').open('a') as f:f.write(str(os.getpid())+'\n')
def emit(o):print(json.dumps(o),flush=True)
for line in sys.stdin:
 m=json.loads(line);method=m.get('method');rid=m.get('id');p=m.get('params',{})
 if rid is None:continue
 if method=='initialize':result={}
 elif method in ['thread/start','thread/fork']:result={'thread':{'id':'thread-'+str(os.getpid())}}
 elif method=='turn/start':result={'turn':{'id':'turn-1'}}
 else:result={}
 emit({'id':rid,'result':result})
 if method=='turn/start':
  common={'threadId':p['threadId'],'turnId':'turn-1'}
  emit({'method':'item/started','params':dict(common,item={'id':'msg','type':'agentMessage'})})
  emit({'method':'item/completed','params':dict(common,item={'id':'msg','type':'agentMessage','text':'OK'})})
  emit({'method':'turn/completed','params':dict(common,turn={'id':'turn-1','status':'completed'})})
