{
  "guide": {
    "summary": "ServiceCheck runs a database and web service with scoped values and consumers.",
    "prose": "Package servicecheck runs a database, web service, parallel command consumers,\nand an agent through scoped orchestration and secrets backends. The database\nand web server publish their connection values through ENV_FILE. The agent\nobtains its values by calling back into Gimbal from its consuming scope.\n\nThe execution environment needs Docker, psql, Python 3, and access to the\npostgres:17-alpine image. Services are stopped when their declaring scope ends.\nThe default devops-tasks model is gpt-5.6-luna; --devops-tasks overrides it.\nSuccess means the database query, web response, and agent's fetched response\nall contain GIMBAL_SERVICE_OK, followed by successful scoped cleanup.\n\nExample:\n\n\tgimbal run service-check --work-dir /abs/work --task-route @/abs/route.json --devops-tasks gpt-5.6-luna",
    "parameters": [
      {
        "name": "Task",
        "flag": "task",
        "kind": "string",
        "description": "Task adds instructions after the agent fetches the web service.",
        "required": true
      }
    ],
    "roles": [
      {
        "name": "devops-tasks",
        "default": "gpt-5.6-luna"
      }
    ],
    "invocation": "gimbal run service-check --work-dir /abs/work --task-route @/abs/route.json --devops-tasks gpt-5.6-luna",
    "snapshot": "7ee855f61d5bdea8e6196c3d1633b91175660d26b6e52eab5dded42612f66290"
  },
