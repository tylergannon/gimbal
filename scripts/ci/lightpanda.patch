@@ -276,0 +280,60 @@ fn evalFeature(text: []const u8, viewport: Viewport) bool {
+const RangeOperator = struct {
+    at: usize,
+    len: usize,
+    direction: u8,
+    equal: bool,
+};
+
+fn rangeOperator(text: []const u8) ?RangeOperator {
+    var i: usize = 0;
+    while (i < text.len) {
+        i = skipWsAndComments(text, i);
+        if (i == text.len) break;
+        const c = text[i];
+        if (c == '<' or c == '>' or c == '=') {
+            const equal = c == '=' or (i + 1 < text.len and text[i + 1] == '=');
+            return .{ .at = i, .len = if (c != '=' and equal) 2 else 1, .direction = c, .equal = equal };
+        }
+        i += 1;
+    }
+    return null;
+}
+
+const RangeOperand = struct { value: u32, feature: bool };
+
+fn rangeOperand(text: []const u8, viewport: Viewport) ?RangeOperand {
+    const value = trimWsAndComments(text);
+    if (std.ascii.eqlIgnoreCase(value, "width") or std.ascii.eqlIgnoreCase(value, "device-width")) {
+        return .{ .value = viewport.width, .feature = true };
+    }
+    if (std.ascii.eqlIgnoreCase(value, "height") or std.ascii.eqlIgnoreCase(value, "device-height")) {
+        return .{ .value = viewport.height, .feature = true };
+    }
+    return .{ .value = parseLengthPx(value) orelse return null, .feature = false };
+}
+
+fn rangeCompare(left: u32, op: RangeOperator, right: u32) bool {
+    if (op.equal and left == right) return true;
+    return switch (op.direction) {
+        '<' => left < right,
+        '>' => left > right,
+        else => false,
+    };
+}
+
+fn evalRange(text: []const u8, first: RangeOperator, viewport: Viewport) bool {
+    const left = rangeOperand(text[0..first.at], viewport) orelse return false;
+    const rest = text[first.at + first.len ..];
+    if (rangeOperator(rest)) |second| {
+        // A chained range has one feature in the middle and points in one direction.
+        if (first.direction == '=' or first.direction != second.direction) return false;
+        const middle = rangeOperand(rest[0..second.at], viewport) orelse return false;
+        const right = rangeOperand(rest[second.at + second.len ..], viewport) orelse return false;
+        if (left.feature or !middle.feature or right.feature) return false;
+        return rangeCompare(left.value, first, middle.value) and rangeCompare(middle.value, second, right.value);
+    }
+    const right = rangeOperand(rest, viewport) orelse return false;
+    if (left.feature == right.feature) return false;
+    return rangeCompare(left.value, first, right.value);
+}
+
