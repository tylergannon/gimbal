{
  "name": "gimbal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vp test",
    "test": "pnpm run test:unit -- --run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:workflow": "node --test tests/workflow/*.test.mjs dev/source-plugin.test.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.52.0",
    "@skgo/sveltekit-adapter": "0.22.1",
    "@storybook/addon-svelte-csf": "latest",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/sveltekit": "^10.6.1",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.4",
    "@vitest/browser-playwright": "catalog:",
    "@xyflow/svelte": "1.7.0",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "elkjs": "0.12.0",
    "playwright": "^1.64.0",
    "shadcn-svelte": "^1.7.0",
    "storybook": "^10.6.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "^3.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  }
}
